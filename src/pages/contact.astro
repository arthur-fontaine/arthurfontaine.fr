---
import Layout from "../layouts/Layout.astro";

const mail = "me@arthurfontaine.fr";
---

<Layout>
  <a href="/" class="font-light block mb-8" data-astro-prefetch>← Home</a>

  <div class="!my-auto md:!my-0">
    <h1>Contact Me</h1>

    <p>Pick whichever is easiest for you.</p>

    <ul class="list-none p-0 space-y-3 [&>li]:p-0 [&>li]:font-light">
      <li>
        An email at <a href={`mailto:${mail}`}>{mail}</a>
      </li>
      <li>
        A DM on <a href="https://x.com/voithure">Twitter</a>
      </li>
      <li>
        A DM on <a href="https://discord.com/users/voithure">Discord</a>
      </li>
    </ul>

    <p class="mt-10">
      Anything is fine. A question, an idea, or just hello. I always like
      hearing from people.
    </p>
  </div>
</Layout>
