---
import { Image } from "astro:assets";
import babyMeImage from "../assets/baby-me.jpg";
import Project from "../components/Project.astro";
import ShowOnHover from "../components/ShowOnHover.astro";
import Layout from "../layouts/Layout.astro";
import imageIcon from "../assets/icons/image.svg?raw";
---

<Layout>
	<header>
		<h1 class="mb-0">Arthur Leconte-Fontaine</h1>
		<h2 class="text-[var(--prose-body)] mt-4">
			Software engineer, developer tooling and open source
		</h2>

		<ul
			class="flex space-x-4 mt-8 list-none p-0 [&>li]:p-0 [&>li>a]:font-light flex-wrap"
		>
			<li>
				<a href="https://x.com/voithure">Twitter</a>
			</li>
			<li>
				<a href="https://github.com/arthur-fontaine">GitHub</a>
			</li>
			<li>
				<a href="https://linkedin.com/in/arthur-fontaine">LinkedIn</a>
			</li>
		</ul>
	</header>

	<section>
		<h2>My Story</h2>
		<p>
			Computers have been a passion since I was very young. My first photo
			typing on one?
			<ShowOnHover
				class="hidden supports-hover:inline"
				as="span"
				as:children="span"
			>
				<!-- This text should be on the same line than the overlay to avoid extra space -->
				I was barely 1 year old<span class="inline-block box-content w-[0.78em] pl-[0.3em] align-baseline"><span class="inline-block w-[0.78em] h-[0.78em] align-[0.18em] [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={imageIcon} /></span>.<span slot="overlay"
					><Image
						src={babyMeImage}
						alt="Me at 1 year old"
						class="rounded-lg !m-0 min-w-64 absolute top-2 left-2"
					/>
					<!-- This span should be on the same line than the overlay to avoid extra space -->
				</span></ShowOnHover
				><span class="supports-hover:hidden">I was barely 1 year old.</span>
			That fascination with technology, and the urge to invent things, led me
			straight to software, where I get to mix creativity and logic.
		</p>

		<a href="/story" class="font-light" data-astro-prefetch>
			→ Discover More About Me</a
		>

		<a href="/contact" class="btn mt-4" data-astro-prefetch>Contact Me</a>
	</section>

	<section>
		<h2>My Work</h2>

		<div class="flex flex-col space-y-4">
			<Project
				title="tuan"
				description="Turns code into a navigable graph. A Rust core parses TypeScript with Oxc, builds and clusters dependency graphs, then reaches Node through napi bindings. Available as a VS Code extension."
				link="https://tuan.world"
			/>

			<Project
				title="Agrume"
				description="A type-safe RPC library that extracts server functions from frontend code at build time, with first-party plugins for 7 build tools (Vite, Rolldown, Rollup, esbuild, Rspack, Farm and Babel)."
				link="https://github.com/arthur-fontaine/agrume"
			/>

			<Project
				title="Kazam"
				description="A compiler for a custom component language (.kaz), with a hand-written parser, a typed AST and code generators for React, Vue and TypeScript."
				link="https://github.com/bywhitebird/kazam"
			/>
		</div>
	</section>
</Layout>
